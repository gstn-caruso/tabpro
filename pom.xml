<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.gstncaruso.tabpro</groupId>
  <artifactId>tabpro-parent</artifactId>
  <version>0.38.0</version>
  <packaging>pom</packaging>

  <name>Tabpro</name>
  <description>Clon libre de Guitar Pro 5: editor de tablaturas para guitarra.</description>
  <url>https://github.com/gstn-caruso/tabpro</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <modules>
    <module>tabpro-core</module>
    <module>tabpro-midi</module>
    <module>tabpro-format</module>
    <module>tabpro-ui</module>
    <module>tabpro-app</module>
    <module>tabpro-tests</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>5.11.4</junit.version>
    <tests.excluded.groups>integracion</tests.excluded.groups>
    <!--
      La auditoria de uso real (tabpro-app/src/test/.../audit) instancia la ventana principal de
      verdad para despachar eventos de teclado y de mouse reales: necesita un toolkit no headless
      para tener foco y peers de verdad. Por defecto sigue en true (identico a como corria
      siempre mvn -B verify); solo el grupo integracion se invoca con -Dtests.headless=false.
    -->
    <tests.headless>true</tests.headless>
    <flatlaf.version>3.7.2</flatlaf.version>
    <gson.version>2.14.0</gson.version>
    <jsvg.version>2.1.0</jsvg.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.formdev</groupId>
        <artifactId>flatlaf</artifactId>
        <version>${flatlaf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.weisj</groupId>
        <artifactId>jsvg</artifactId>
        <version>${jsvg.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!--
              El add-exports es para WaveRenderer (tabpro-midi): renderiza WAVE fuera de
              tiempo real con com.sun.media.sound.AudioSynthesizer, el unico camino que expone
              Gervill (el sintetizador del JDK) para eso. No es API publica, pero es la unica
              forma de pedirle audio al sintetizador mas rapido que en tiempo real.
            -->
            <!--
              TieredStopAtLevel=1 deja el JIT en C1. La suite entera vive medio segundo:
              compilar con C2 cuesta mas de lo que llega a devolver antes de que la maquina
              virtual termine.
            -->
            <!--
              java.util.prefs.userRoot y java.io.tmpdir aislados: MainFrame guarda Preferences
              (archivos recientes, autoguardado, etc.) en java.util.prefs.Preferences.userRoot(),
              y ScoreDocument busca su archivo de recuperacion en java.io.tmpdir +
              "tabpro-recuperacion" -las mismas rutas que usa un tabpro instalado de verdad en
              esta maquina-. La auditoria de uso real (tabpro-app/.../audit) instancia MainFrame
              de verdad: sin esto, un archivo de recuperacion real que haya quedado de una sesion
              real dispara un dialogo real (offerToRecover) en cada test, y las preferencias que
              se lean o se escriban serian las reales de quien corre la suite.
            -->
            <argLine>-Djava.awt.headless=${tests.headless} -XX:TieredStopAtLevel=1 --add-exports=java.desktop/com.sun.media.sound=ALL-UNNAMED -Djava.util.prefs.userRoot=${project.build.directory}/test-prefs-root -Djava.io.tmpdir=${project.build.directory}</argLine>
            <excludedGroups>${tests.excluded.groups}</excludedGroups>
            <skipTests>true</skipTests>
            <properties>
              <configurationParameters>
                junit.jupiter.execution.parallel.enabled=true
                junit.jupiter.execution.parallel.mode.default=concurrent
                junit.jupiter.execution.parallel.mode.classes.default=concurrent
              </configurationParameters>
            </properties>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
