<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.gstncaruso.tabpro</groupId>
    <artifactId>tabpro-parent</artifactId>
    <version>0.23.2</version>
  </parent>

  <artifactId>tabpro-app</artifactId>
  <packaging>jar</packaging>

  <name>Tabpro App</name>
  <description>Aplicación de escritorio (interfaz gráfica) del editor de tablaturas.</description>
  <url>https://github.com/gstn-caruso/tabpro</url>

  <dependencies>
    <dependency>
      <groupId>com.gstncaruso.tabpro</groupId>
      <artifactId>tabpro-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.gstncaruso.tabpro</groupId>
      <artifactId>tabpro-format</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.gstncaruso.tabpro</groupId>
      <artifactId>tabpro-midi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.gstncaruso.tabpro</groupId>
      <artifactId>tabpro-ui</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.gstncaruso.tabpro.app.App</mainClass>
                  <manifestEntries>
                    <!--
                      WaveRenderer (tabpro-midi) usa com.sun.media.sound.AudioSynthesizer para
                      exportar WAVE fuera de tiempo real. El atributo Add-Exports del manifest
                      hace que el lanzador de "java -jar" le de acceso, sin pedirle flags al
                      usuario.
                    -->
                    <Add-Exports>java.desktop/com.sun.media.sound</Add-Exports>
                  </manifestEntries>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.vafer</groupId>
        <artifactId>jdeb</artifactId>
        <version>1.11</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>jdeb</goal>
            </goals>
            <configuration>
              <deb>${project.build.directory}/tabpro_${project.version}_all.deb</deb>
              <controlDir>${project.basedir}/src/deb/control</controlDir>
              <dataSet>
                <data>
                  <src>${project.build.directory}/${project.build.finalName}.jar</src>
                  <type>file</type>
                  <dst>tabpro-app.jar</dst>
                  <mapper>
                    <type>perm</type>
                    <prefix>/usr/share/tabpro</prefix>
                    <filemode>644</filemode>
                  </mapper>
                </data>
                <data>
                  <src>${project.basedir}/src/deb/tabpro</src>
                  <type>file</type>
                  <mapper>
                    <type>perm</type>
                    <prefix>/usr/bin</prefix>
                    <filemode>755</filemode>
                  </mapper>
                </data>
                <data>
                  <src>${project.basedir}/src/deb/tabpro.desktop</src>
                  <type>file</type>
                  <mapper>
                    <type>perm</type>
                    <prefix>/usr/share/applications</prefix>
                    <filemode>644</filemode>
                  </mapper>
                </data>
                <data>
                  <src>${project.basedir}/src/deb/tabpro-mime.xml</src>
                  <type>file</type>
                  <dst>tabpro.xml</dst>
                  <mapper>
                    <type>perm</type>
                    <prefix>/usr/share/mime/packages</prefix>
                    <filemode>644</filemode>
                  </mapper>
                </data>
                <data>
                  <src>${project.basedir}/src/deb/icons/tabpro.svg</src>
                  <type>file</type>
                  <mapper>
                    <type>perm</type>
                    <prefix>/usr/share/icons/hicolor/scalable/apps</prefix>
                    <filemode>644</filemode>
                  </mapper>
                </data>
              </dataSet>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
